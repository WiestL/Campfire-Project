{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Campfire.Api",
    "Audience": "Campfire.Client",
    "SigningKey": "dev-only-signing-key-not-for-production-use-change-me-32bytes",
